<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>AxamlLs</AssemblyName>
    <RootNamespace>AxamlLs</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>Engel-167</Authors>
    <Copyright>Copyright (c) 2026 Engel-167</Copyright>
    <Product>axaml-ls</Product>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Roslyn's MSBuildWorkspace runs project evaluation in a separate BuildHost process. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AxamlLs.Tests" />
  </ItemGroup>
</Project>
